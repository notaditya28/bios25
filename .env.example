# Copy to .env and fill in. Never commit .env.

# --- Core ---------------------------------------------------------------
APP_ENV=development                 # development | test | production
APP_BASE_URL=http://localhost:3000  # public URL of the web app (used in emails)
SECRET_KEY=change-me-to-64-random-chars   # python -c "import secrets;print(secrets.token_urlsafe(48))"
LOG_LEVEL=INFO

# --- Database / cache ---------------------------------------------------
POSTGRES_USER=traderadar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=traderadar
DATABASE_URL=postgresql+psycopg://traderadar:change-me@db:5432/traderadar
REDIS_URL=redis://redis:6379/0

# --- Auth ---------------------------------------------------------------
SESSION_TTL_HOURS=336               # 14 days
COOKIE_SECURE=false                 # must be true in production (HTTPS)
LOGIN_RATE_LIMIT_PER_15MIN=10

# --- Email --------------------------------------------------------------
EMAIL_BACKEND=smtp                  # smtp (Mailpit in dev) | postmark
EMAIL_FROM=TradeRadar <alerts@example.com>
SMTP_HOST=mailpit
SMTP_PORT=1025
POSTMARK_SERVER_TOKEN=

# --- Data sources (see docs/DATA_SOURCES.md) -----------------------------
# Port reference data: no keys required (UN/LOCODE, NGA WPI, Natural Earth)
SOURCE_HTTP_TIMEOUT_S=120
SOURCE_USER_AGENT=TradeRadar/0.1 (+contact: ops@example.com)

# Used from later milestones
ANTHROPIC_API_KEY=
AISSTREAM_API_KEY=
EU_FSF_TOKEN=
OPEN_METEO_API_KEY=                 # required in production (free tier is non-commercial)
PORTWATCH_ENABLED=false             # keep false until IMF grants commercial permission

# --- DEV ONLY -----------------------------------------------------------
# The seed script refuses to run unless APP_ENV=development AND this is true.
ALLOW_DEV_SEED=false
